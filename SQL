//Data-quality SQL
Before Power BI, check your data.
Duplicate orders

SELECT
    order_id,
    COUNT(*) AS duplicate_count
FROM fact_supply_chain
GROUP BY order_id
HAVING COUNT(*) > 1;

// Missing values

SELECT
    COUNT(*) FILTER (WHERE order_id IS NULL) AS missing_orders,
    COUNT(*) FILTER (WHERE order_date IS NULL) AS missing_order_dates,
    COUNT(*) FILTER (WHERE product_id IS NULL) AS missing_products,
    COUNT(*) FILTER (WHERE supplier_id IS NULL) AS missing_suppliers,
    COUNT(*) FILTER (WHERE quantity IS NULL) AS missing_quantity
FROM fact_supply_chain;

// 4. SQL KPI queries
// Total orders
SELECT
    COUNT(DISTINCT order_id) AS total_orders
FROM fact_supply_chain;

// Total sales
SELECT
    ROUND(SUM(sales_amount), 2) AS total_sales
FROM fact_supply_chain;

// Total quantity
SELECT
    SUM(quantity) AS total_quantity
FROM fact_supply_chain;

//Average order value
SELECT
    ROUND(
        SUM(sales_amount) / NULLIF(COUNT(DISTINCT order_id), 0),
        2
    ) AS avg_order_value
FROM fact_supply_chain;

// Supplier Analysis
5. On-time delivery SQL
SELECT
    COUNT(DISTINCT CASE
        WHEN delivery_date <= promised_date
        THEN order_id
    END) AS on_time_orders,

    COUNT(DISTINCT order_id) AS total_orders,

    ROUND(
        100.0 *
        COUNT(DISTINCT CASE
            WHEN delivery_date <= promised_date
            THEN order_id
        END)
        / NULLIF(COUNT(DISTINCT order_id), 0),
        2
    ) AS on_time_delivery_pct
FROM fact_supply_chain;

// 6. Delayed orders
SELECT
    order_id,
    promised_date,
    delivery_date,
    delivery_date - promised_date AS delay_days
FROM fact_supply_chain
WHERE delivery_date > promised_date
ORDER BY delay_days DESC;

// 7. Average lead time
SELECT
    ROUND(
        AVG(delivery_date - order_date),
        2
    ) AS avg_lead_time_days
FROM fact_supply_chain
WHERE delivery_date IS NOT NULL;

// 8. Supplier performance
SELECT
    supplier_id,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(SUM(sales_amount), 2) AS total_sales,

    ROUND(
        AVG(delivery_date - order_date),
        2
    ) AS avg_lead_time,

    ROUND(
        100.0 *
        COUNT(DISTINCT CASE
            WHEN delivery_date <= promised_date
            THEN order_id
        END)
        / NULLIF(COUNT(DISTINCT order_id), 0),
        2
    ) AS on_time_delivery_pct

FROM fact_supply_chain
GROUP BY supplier_id
ORDER BY on_time_delivery_pct DESC;

// 9. Region performance
SELECT
    region_id,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(SUM(sales_amount), 2) AS total_sales,
    SUM(quantity) AS total_quantity,
    ROUND(
        100.0 *
        COUNT(DISTINCT CASE
            WHEN delivery_date <= promised_date
            THEN order_id
        END)
        / NULLIF(COUNT(DISTINCT order_id), 0),
        2
    ) AS on_time_delivery_pct
FROM fact_supply_chain
GROUP BY region_id
ORDER BY total_sales DESC;

// 10. Monthly performance
SELECT
    DATE_TRUNC('month', order_date) AS month,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(SUM(sales_amount), 2) AS total_sales,
    SUM(quantity) AS total_quantity
FROM fact_supply_chain
GROUP BY DATE_TRUNC('month', order_date)
ORDER BY month;

// 11. Top 10 products
SELECT
    product_id,
    SUM(quantity) AS total_quantity,
    ROUND(SUM(sales_amount), 2) AS total_sales
FROM fact_supply_chain
GROUP BY product_id
ORDER BY total_sales DESC
LIMIT 10;
